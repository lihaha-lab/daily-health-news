# CondenseIt environment configuration
# Copy to .env and fill in your values.
# Never commit .env - it contains secrets.

# ---------------------------------------------------------------------------
# DAILY HEALTH NEWS PROJECT
# ---------------------------------------------------------------------------
TOPIC_PACK=health
APP_PORT=8899
TZ=Pacific/Auckland

# ---------------------------------------------------------------------------
# LOCAL MODE (Ollama managed by Docker Compose)
# ---------------------------------------------------------------------------
# Models are stored in ./data/ollama so they move with the project data. The
# Ollama API is only available inside the Compose network.
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=10m

# ---------------------------------------------------------------------------
# REMOTE MODE (optional OpenRouter alternative)
# ---------------------------------------------------------------------------
# The health topic pack uses Ollama by default; this key is only needed when
# switching to OpenRouter in the model settings.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional OpenAI-compatible endpoint. This can point to a local service or a
# hosted provider. Leave blank while the project is running in collection-only
# mode.
OPENAI_API_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Built-in scheduler
# Set to 1 to run digests automatically at the times configured in the admin.
# Recommended for remote VPS deployments (replaces cron/launchd).
# ---------------------------------------------------------------------------
CONDENSEIT_SCHEDULER_ENABLED=1

# ---------------------------------------------------------------------------
# Customer delivery (optional until credentials are provided)
# ---------------------------------------------------------------------------
# Set FEISHU_DIGEST_DOCUMENT_ID to append every day to one existing document.
# Without it, the legacy fallback creates monthly documents in the selected
# folder. FEISHU_FOLDER_TOKEN applies only to that fallback.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=
FEISHU_DIGEST_DOCUMENT_ID=
FEISHU_DIGEST_DOCUMENT_URL=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# WeCom group bot webhook URL. Treat it as a secret.
WECOM_WEBHOOK_URL=
# WeCom self-built app personal delivery (to a WeCom member, not personal WeChat).
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_TO_USER=
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com

# ---------------------------------------------------------------------------
# Auth (recommended for any internet-facing deployment)
# Leave both empty to disable login (anyone with the URL can access).
# ---------------------------------------------------------------------------
# Password for the login screen on the web UI.
CONDENSEIT_AUTH_PASSWORD=
# Legacy alias kept for older deployments.
DIGEST_PWA_AUTH_PASSWORD=
# Fixed session secret - prevents log-out on service restart.
# Generate: openssl rand -hex 32
DIGEST_PWA_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Paths (optional overrides)
# ---------------------------------------------------------------------------
CONDENSEIT_CONFIG=config/topic-packs/health/config.yaml
CONDENSEIT_DATA_DIR=data
# Set to frontend/dist path when running in Docker or non-repo layout.
CONDENSEIT_FRONTEND_DIST=

# ---------------------------------------------------------------------------
# Digest limits (optional overrides for YAML config)
# ---------------------------------------------------------------------------
CONDENSEIT_MAX_ARTICLES_PER_DIGEST=
CONDENSEIT_USER_AGENT=

# ---------------------------------------------------------------------------
# VPS deployment (used by scripts/deploy.sh)
# ---------------------------------------------------------------------------
DIGEST_PWA_SSH_HOST=
DIGEST_PWA_DOMAIN=
DIGEST_PWA_REMOTE_DIR=/var/www/digest.example.com
DIGEST_PWA_LIVE_URL=
CONDENSEIT_VPS_PORT=8765
CONDENSEIT_VPS_DATA_DIR=
